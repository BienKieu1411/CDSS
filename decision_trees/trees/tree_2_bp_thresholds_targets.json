          "title": "Có bệnh đồng mắc không?",
          "shortLabel": "Kiểm tra BĐM"
        },
        "logic": {
          "predicate": {
            "any": [
              { "field": "condition.hasEarlyMenopause", "op": "eq", "value": true },
              { "field": "condition.hasDiabetesMellitus", "op": "eq", "value": true },
              { "field": "condition.hasType2DiabetesMellitus", "op": "eq", "value": true },
              { "field": "condition.hasLeftVentricularHypertrophy", "op": "eq", "value": true },
              { "field": "condition.hasCoronaryArteryDisease", "op": "eq", "value": true },
              { "field": "condition.hasHeartFailure", "op": "eq", "value": true },
              { "field": "condition.hasHeartFailureWithReducedEjectionFraction", "op": "eq", "value": true },
              { "field": "condition.hasStroke", "op": "eq", "value": true },
              { "field": "condition.hasPeripheralArteryDisease", "op": "eq", "value": true },
              { "field": "condition.hasAtrialFibrillation", "op": "eq", "value": true },
              { "field": "condition.hasChronicKidneyDisease", "op": "eq", "value": true },
              { "field": "cardiovascular.hasEstablishedCvd", "op": "eq", "value": true },
              { "field": "risk.hasTargetOrganDamage", "op": "eq", "value": true }
            ]
          }
        },
        "onMissingData": "stop",
        "sourceRefs": [
          {
