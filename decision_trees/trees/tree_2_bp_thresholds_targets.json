          }
        ]
      },
      {
        "id": "bp_target_hypertension_first_visit_gate",
        "type": "condition",
        "display": {
          "title": "Đây có phải là lần khám đầu tiên của người bệnh THA không?",
          "shortLabel": "THA — lần đầu"
        },
        "logic": {
          "predicate": {
            "field": "encounter.number",
            "op": "eq",
            "value": 1
          }
        },
        "onMissingData": "stop",
