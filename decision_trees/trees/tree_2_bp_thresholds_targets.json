{
  "formatVersion": "decision-tree.v1",
  "tree": {
    "id": "bp_thresholds_targets",
    "name": "Cây 2 — Ngưỡng huyết áp mục tiêu",
    "purpose": "Xác định xử trí ban đầu và mục tiêu huyết áp theo chẩn đoán Cây 1, lần khám đầu hay không, và tình trạng bệnh đồng mắc.",
    "clinicalStatus": "draft",
    "entryNodeId": "bp_target_start",
    "inputVariables": [
      "hypertension.diagnosisCategory",
      "encounter.number",
      "condition.hasEarlyMenopause",
      "condition.hasDiabetesMellitus",
      "condition.hasType2DiabetesMellitus",
      "condition.hasLeftVentricularHypertrophy",
      "condition.hasCoronaryArteryDisease",
      "condition.hasHeartFailure",
      "condition.hasHeartFailureWithReducedEjectionFraction",
      "condition.hasStroke",
      "condition.hasPeripheralArteryDisease",
      "condition.hasAtrialFibrillation",
      "condition.hasChronicKidneyDisease",
      "cardiovascular.hasEstablishedCvd",
      "risk.hasTargetOrganDamage"
    ],
    "outputVariables": [
      "treatment.targetSystolicBpMmHg",
      "treatment.targetDiastolicBpMmHg"
    ],
    "linksTo": ["optimized_hypertension_treatment"],
    "nodes": [
      {
        "id": "bp_target_start",
        "type": "start",
        "display": {
          "title": "Bắt đầu xác định mục tiêu huyết áp",
          "detail": "Nhận kết quả chẩn đoán từ Cây 1 và thông tin lần khám/bệnh đồng mắc."
        },
        "sourceRefs": [
          {
            "sourceId": "image_02_bp_thresholds_targets",
            "page": 1,
            "section": "Ngưỡng huyết áp mục tiêu",
            "tableOrFigure": "codex-clipboard-b3cb5c5e-7c4c-4bb6-ba1e-ba714c66d054.png",
            "note": "Sơ đồ người dùng cung cấp"
          }
        ]
      },
      {
        "id": "bp_target_diagnosis_gate",
        "type": "condition",
        "display": {
          "title": "Chẩn đoán từ Cây 1 là HABTC hay THA?",
          "shortLabel": "Phân nhánh chẩn đoán"
        },
        "logic": {
          "predicate": {
            "all": [
              {
                "field": "hypertension.diagnosisCategory",
                "op": "in",
                "value": ["hypertension", "high_normal_bp"]
              }
            ]
          }
        },
        "onMissingData": "stop",
        "sourceRefs": [
          {
            "sourceId": "image_02_bp_thresholds_targets",
            "page": 1,
            "section": "Ngưỡng huyết áp mục tiêu",
            "tableOrFigure": "codex-clipboard-b3cb5c5e-7c4c-4bb6-ba1e-ba714c66d054.png",
            "note": "Chẩn đoán THA (cây 1) gồm nhánh HABTC và THA"
          }
        ]
      },
      {
        "id": "bp_target_is_hypertension_gate",
        "type": "condition",
        "display": {
          "title": "Chẩn đoán là THA?",
          "shortLabel": "THA"
        },
        "logic": {
          "predicate": {
            "field": "hypertension.diagnosisCategory",
            "op": "eq",
            "value": "hypertension"
          }
        },
        "onMissingData": "stop",
        "sourceRefs": [
          {
            "sourceId": "image_02_bp_thresholds_targets",
            "page": 1,
            "section": "Ngưỡng huyết áp mục tiêu",
            "tableOrFigure": "codex-clipboard-b3cb5c5e-7c4c-4bb6-ba1e-ba714c66d054.png",
            "note": "Nhánh THA"
          }
        ]
      },
      {
        "id": "bp_target_not_applicable",
        "type": "end",
        "display": {
          "title": "Không thuộc nhánh HABTC/THA của Cây 2",
          "shortLabel": "Không áp dụng"
        },
        "data": {
          "outcomeCode": "bp_target_tree_not_applicable"
        },
        "sourceRefs": [
          {
            "sourceId": "image_02_bp_thresholds_targets",
            "page": 1,
            "section": "Ngưỡng huyết áp mục tiêu",
