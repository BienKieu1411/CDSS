        "data": { "outcomeCode": "age_18_69_without_comorbidity", "sets": { "treatment.medicationStartSystolicBpMmHg": 140, "treatment.medicationStartDiastolicBpMmHg": 90, "treatment.targetSystolicBpMmHg": 140, "treatment.targetDiastolicBpMmHg": 80 } },
        "sourceRefs": [{ "sourceId": "image_02_bp_thresholds_targets", "page": 1, "section": "Bảng 6 và Bảng 7", "tableOrFigure": "Bảng 6 và Bảng 7", "note": "18–69 không BĐM: Bảng 6 ≥140/≥90; Bảng 7 120–<140 và <80" }]
      },
      {
        "id": "age_18_69_with_comorbidity", "type": "end",
        "display": { "title": "18–69 tuổi — có BĐM: ≥130/90 → đích 120–<130/<80", "detail": "Bắt đầu điều trị khi HATT ≥130 hoặc HATTr ≥90. Mục tiêu HATT 120–<130 và HATTr <80.", "shortLabel": "18–69, có BĐM" },
        "data": { "outcomeCode": "age_18_69_with_comorbidity", "sets": { "treatment.medicationStartSystolicBpMmHg": 130, "treatment.medicationStartDiastolicBpMmHg": 90, "treatment.targetSystolicBpMmHg": 130, "treatment.targetDiastolicBpMmHg": 80 } },
        "sourceRefs": [{ "sourceId": "image_02_bp_thresholds_targets", "page": 1, "section": "Bảng 6 và Bảng 7", "tableOrFigure": "Bảng 6 và Bảng 7", "note": "18–69 có BĐM: Bảng 6 ≥130/≥90; Bảng 7 120–<130 và <80" }]
      },
      {
        "id": "age_70_79_target", "type": "end",
        "display": { "title": "70–79 tuổi: ≥140/90 → đích <140/<80", "detail": "Bắt đầu điều trị khi HATT ≥140 hoặc HATTr ≥90. Có thể hạ HATT đến 130 mmHg nếu dung nạp.", "shortLabel": "70–79 tuổi" },
        "data": { "outcomeCode": "age_70_79", "sets": { "treatment.medicationStartSystolicBpMmHg": 140, "treatment.medicationStartDiastolicBpMmHg": 90, "treatment.targetSystolicBpMmHg": 140, "treatment.targetDiastolicBpMmHg": 80 } },
        "sourceRefs": [{ "sourceId": "image_02_bp_thresholds_targets", "page": 1, "section": "Bảng 6 và Bảng 7", "tableOrFigure": "Bảng 6 và Bảng 7", "note": "70–79 tuổi: ≥140/≥90; mục tiêu HATT <140, có thể hạ đến 130" }]
      },
      {
        "id": "age_80_plus_target", "type": "end",
        "display": { "title": "≥80 tuổi: ≥160/90 → đích <140/<80", "detail": "Bắt đầu điều trị khi HATT ≥160 hoặc HATTr ≥90. Mục tiêu HATT <140 và HATTr <80.", "shortLabel": "≥80 tuổi" },
        "data": { "outcomeCode": "age_80_plus", "sets": { "treatment.medicationStartSystolicBpMmHg": 160, "treatment.medicationStartDiastolicBpMmHg": 90, "treatment.targetSystolicBpMmHg": 140, "treatment.targetDiastolicBpMmHg": 80 } },
        "sourceRefs": [{ "sourceId": "image_02_bp_thresholds_targets", "page": 1, "section": "Bảng 6 và Bảng 7", "tableOrFigure": "Bảng 6 và Bảng 7", "note": "≥80 tuổi: ≥160/≥90; mục tiêu HATT <140" }]
      },
      {
        "id": "age_target_link_treatment", "type": "link",
        "display": { "title": "Chuyển sang đánh giá phác đồ điều trị", "shortLabel": "Cây tiếp theo" },
        "data": { "targetTreeId": "optimized_hypertension_treatment", "callMode": "navigate_only" },
        "sourceRefs": [{ "sourceId": "image_02_bp_thresholds_targets", "page": 1, "section": "Bảng 6 và Bảng 7", "tableOrFigure": "Bảng 6 và Bảng 7", "note": "Chuyển mục tiêu sang cây điều trị" }]
      }
    ],
    "edges": [
