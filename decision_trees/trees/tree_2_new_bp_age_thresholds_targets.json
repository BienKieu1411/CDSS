        "onMissingData": "stop",
        "sourceRefs": [{ "sourceId": "image_02_bp_thresholds_targets", "page": 1, "section": "Bảng 6 và Bảng 7", "tableOrFigure": "Bảng 6 và Bảng 7", "note": "≥80 tuổi: ngưỡng điều trị giống nhau có hoặc không có bệnh đồng mắc" }]
