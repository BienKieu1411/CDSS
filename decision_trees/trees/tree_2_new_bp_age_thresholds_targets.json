{
  "formatVersion": "decision-tree.v1",
  "tree": {
    "id": "bp_age_thresholds_targets",
    "name": "Cây 2_new — Ngưỡng và mục tiêu theo tuổi",
    "purpose": "Xác định ngưỡng bắt đầu điều trị và mục tiêu huyết áp theo nhóm tuổi và bệnh đồng mắc dựa trên Bảng 6 và Bảng 7.",
    "clinicalStatus": "draft",
    "entryNodeId": "age_target_start",
    "inputVariables": [
      "patient.ageYears",
      "hypertension.diagnosisCategory",
      "condition.hasDiabetesMellitus",
      "condition.hasType2DiabetesMellitus",
      "condition.hasCoronaryArteryDisease",
      "condition.hasHeartFailure",
      "condition.hasChronicKidneyDisease",
      "condition.hasStroke",
      "cardiovascular.hasEstablishedCvd",
      "risk.hasTargetOrganDamage"
    ],
    "outputVariables": [
      "treatment.medicationStartSystolicBpMmHg",
      "treatment.medicationStartDiastolicBpMmHg",
      "treatment.targetSystolicBpMmHg",
      "treatment.targetDiastolicBpMmHg"
    ],
    "linksTo": ["optimized_hypertension_treatment"],
    "nodes": [
      {
        "id": "age_target_start", "type": "start",
        "display": { "title": "Bắt đầu xác định ngưỡng và mục tiêu huyết áp theo tuổi" },
        "sourceRefs": [{ "sourceId": "image_02_bp_thresholds_targets", "page": 1, "section": "Bảng 6 và Bảng 7", "tableOrFigure": "Bảng 6 và Bảng 7", "note": "Bảng người dùng cung cấp" }]
      },
      {
        "id": "age_group_gate", "type": "branch",
        "display": { "title": "Xác định nhóm tuổi", "shortLabel": "Nhóm tuổi" },
        "logic": { "cases": [
          { "id": "age_18_69", "label": "18–69 tuổi", "predicate": { "all": [{ "field": "patient.ageYears", "op": "gte", "value": 18 }, { "field": "patient.ageYears", "op": "lte", "value": 69 }] } },
          { "id": "age_70_79", "label": "70–79 tuổi", "predicate": { "all": [{ "field": "patient.ageYears", "op": "gte", "value": 70 }, { "field": "patient.ageYears", "op": "lte", "value": 79 }] } },
          { "id": "age_80_plus", "label": "Từ 80 tuổi trở lên", "predicate": { "field": "patient.ageYears", "op": "gte", "value": 80 } }
        ] },
        "onMissingData": "stop",
        "sourceRefs": [{ "sourceId": "image_02_bp_thresholds_targets", "page": 1, "section": "Bảng 6 và Bảng 7", "tableOrFigure": "Bảng 6 và Bảng 7", "note": "Phân nhóm 18–69, 70–79 và ≥80 tuổi" }]
      },
      {
        "id": "age_18_69_comorbidity_gate", "type": "condition",
        "display": { "title": "Người bệnh 18–69 tuổi có bệnh đồng mắc?", "shortLabel": "18–69 tuổi" },
        "logic": { "predicate": { "any": [
          { "field": "condition.hasDiabetesMellitus", "op": "eq", "value": true }, { "field": "condition.hasType2DiabetesMellitus", "op": "eq", "value": true },
          { "field": "condition.hasCoronaryArteryDisease", "op": "eq", "value": true }, { "field": "condition.hasHeartFailure", "op": "eq", "value": true },
          { "field": "condition.hasChronicKidneyDisease", "op": "eq", "value": true }, { "field": "condition.hasStroke", "op": "eq", "value": true },
          { "field": "cardiovascular.hasEstablishedCvd", "op": "eq", "value": true }, { "field": "risk.hasTargetOrganDamage", "op": "eq", "value": true }
        ] } },
        "onMissingData": "stop",
        "sourceRefs": [{ "sourceId": "image_02_bp_thresholds_targets", "page": 1, "section": "Bảng 6 và Bảng 7", "tableOrFigure": "Bảng 6 và Bảng 7", "note": "18–69 tuổi: tách THA có và không có bệnh đồng mắc" }]
      },
      {
        "id": "age_70_79_comorbidity_gate", "type": "condition",
        "display": { "title": "Người bệnh 70–79 tuổi có bệnh đồng mắc?", "shortLabel": "70–79 tuổi" },
        "logic": { "predicate": { "any": [
          { "field": "condition.hasDiabetesMellitus", "op": "eq", "value": true }, { "field": "condition.hasType2DiabetesMellitus", "op": "eq", "value": true },
          { "field": "condition.hasCoronaryArteryDisease", "op": "eq", "value": true }, { "field": "condition.hasHeartFailure", "op": "eq", "value": true },
          { "field": "condition.hasChronicKidneyDisease", "op": "eq", "value": true }, { "field": "condition.hasStroke", "op": "eq", "value": true },
          { "field": "cardiovascular.hasEstablishedCvd", "op": "eq", "value": true }, { "field": "risk.hasTargetOrganDamage", "op": "eq", "value": true }
        ] } },
        "onMissingData": "stop",
        "sourceRefs": [{ "sourceId": "image_02_bp_thresholds_targets", "page": 1, "section": "Bảng 6 và Bảng 7", "tableOrFigure": "Bảng 6 và Bảng 7", "note": "70–79 tuổi: ngưỡng điều trị giống nhau có hoặc không có bệnh đồng mắc" }]
