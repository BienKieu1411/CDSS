          }
        ]
      },
      {
        "id": "bp_crisis_gate",
        "type": "condition",
        "display": {
          "title": "HA phòng khám lần 1 ≥180/120 hoặc có tổn thương cơ quan đích/bệnh tim mạch?"
        },
        "sourceRefs": [
          {
            "sourceId": "image_01_bp_diagnosis",
            "page": 1,
            "section": "Sơ đồ chẩn đoán tăng huyết áp",
            "tableOrFigure": "01_bp_diagnosis.png",
            "note": "HA phòng khám lần 1 ≥180/120 hoặc có tổn thương cơ quan đích/bệnh tim mạch?"
          }
        ],
        "logic": {
          "predicate": {
            "any": [
              {
                "field": "bp.office1.systolicMmHg",
                "op": "gte",
                "value": 180
              },
              {
                "field": "bp.office1.diastolicMmHg",
                "op": "gte",
                "value": 120
              },
              {
                "field": "comorbidity.targetOrganDamageOrCvd",
                "op": "eq",
                "value": true
              }
            ]
          }
        }
      },
      {
        "id": "bp_infer_crisis",
