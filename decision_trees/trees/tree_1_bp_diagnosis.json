          }
        ],
        "logic": {
          "predicate": {
            "any": [
              {
                "field": "bp.office1.systolicMmHg",
                "op": "gte",
                "value": 180
              },
              {
                "field": "bp.office1.diastolicMmHg",
                "op": "gte",
                "value": 120
              },
              {
                "field": "comorbidity.targetOrganDamageOrCvd",
                "op": "eq",
                "value": true
              },
              {
                "field": "risk.cardiovascularDisease",
                "op": "eq",
                "value": true
              }
            ]
          }
        }
      },
      {
        "id": "bp_crisis_result",
        "type": "end",
        "display": {
          "title": "Cơn tăng huyết áp",
          "detail": "bp.category = hypertensive_crisis"
        },
        "sourceRefs": [
