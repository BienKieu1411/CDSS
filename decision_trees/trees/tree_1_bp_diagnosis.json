{
  "formatVersion": "decision-tree.v1",
  "tree": {
    "id": "bp_diagnosis",
    "name": "Cây 1 — Chẩn đoán tăng huyết áp",
    "purpose": "Phân loại chẩn đoán tăng huyết áp dựa trên ba lần đo huyết áp phòng khám và bằng chứng tổn thương cơ quan đích/bệnh tim mạch.",
    "clinicalStatus": "draft",
    "entryNodeId": "bp_diagnosis_start",
    "inputVariables": [
      "bp.office.measurement1.systolicMmHg",
      "bp.office.measurement1.diastolicMmHg",
      "bp.office.measurement2.systolicMmHg",
      "bp.office.measurement2.diastolicMmHg",
      "bp.office.measurement3.systolicMmHg",
      "bp.office.measurement3.diastolicMmHg",
      "risk.hasTargetOrganDamage",
      "cardiovascular.hasEstablishedCvd"
    ],
    "outputVariables": [
      "hypertension.diagnosisCategory"
    ],
    "linksTo": ["bp_thresholds_targets", "hypertension_risk_stratification"],
    "nodes": [
      {
        "id": "bp_diagnosis_start",
        "type": "start",
        "display": {
          "title": "Bắt đầu đánh giá huyết áp",
          "detail": "Đọc ba cặp huyết áp phòng khám và các biến bệnh kèm đã được chuẩn hóa."
        },
        "sourceRefs": [
          {
            "sourceId": "image_01_bp_diagnosis",
            "page": 1,
            "section": "Sơ đồ chẩn đoán tăng huyết áp",
            "tableOrFigure": "codex-clipboard-18a6b413-7b8f-4c99-9c3c-6367d9872ebc.png",
            "note": "Sơ đồ người dùng cung cấp"
          }
        ]
      },
      {
        "id": "bp_measurement1_crisis_gate",
        "type": "condition",
        "display": {
          "title": "Lần 1: HATT ≥180 hoặc HATTr ≥120 hoặc có tổn thương cơ quan đích/bệnh tim mạch?",
          "shortLabel": "Lần 1 — ngưỡng cơn THA"
        },
        "logic": {
          "predicate": {
            "any": [
              { "field": "bp.office.measurement1.systolicMmHg", "op": "gte", "value": 180 },
              { "field": "bp.office.measurement1.diastolicMmHg", "op": "gte", "value": 120 },
              { "field": "risk.hasTargetOrganDamage", "op": "eq", "value": true },
              { "field": "cardiovascular.hasEstablishedCvd", "op": "eq", "value": true }
            ]
          }
        },
        "onMissingData": "stop",
        "sourceRefs": [
          {
            "sourceId": "image_01_bp_diagnosis",
            "page": 1,
            "section": "Sơ đồ chẩn đoán tăng huyết áp",
            "tableOrFigure": "codex-clipboard-18a6b413-7b8f-4c99-9c3c-6367d9872ebc.png",
            "note": "sys-bp-first ≥180 hoặc dias-bp-first ≥120 hoặc tổn thương cơ quan đích/bệnh tim mạch"
          }
        ]
      },
      {
        "id": "bp_diagnosis_crisis",
        "type": "end",
        "display": {
          "title": "Cơn tăng huyết áp",
          "detail": "hypertension.diagnosisCategory = hypertensive_crisis"
        },
        "data": {
          "outcomeCode": "hypertensive_crisis",
          "sets": { "hypertension.diagnosisCategory": "hypertensive_crisis" }
        },
        "sourceRefs": [
          {
            "sourceId": "image_01_bp_diagnosis",
            "page": 1,
            "section": "Sơ đồ chẩn đoán tăng huyết áp",
            "tableOrFigure": "codex-clipboard-18a6b413-7b8f-4c99-9c3c-6367d9872ebc.png",
            "note": "Nhánh yes của lần đo thứ nhất"
          }
        ]
      },
      {
        "id": "bp_measurement2_hypertension_gate",
        "type": "condition",
        "display": {
          "title": "Lần 2: HATT 140–179 hoặc HATTr 90–119 hoặc có tổn thương cơ quan đích/bệnh tim mạch?",
          "shortLabel": "Lần 2 — ngưỡng THA"
        },
        "logic": {
          "predicate": {
            "any": [
              {
                "all": [
                  { "field": "bp.office.measurement2.systolicMmHg", "op": "gte", "value": 140 },
                  { "field": "bp.office.measurement2.systolicMmHg", "op": "lte", "value": 179 }
                ]
              },
              {
                "all": [
                  { "field": "bp.office.measurement2.diastolicMmHg", "op": "gte", "value": 90 },
                  { "field": "bp.office.measurement2.diastolicMmHg", "op": "lte", "value": 119 }
                ]
              },
              { "field": "risk.hasTargetOrganDamage", "op": "eq", "value": true },
              { "field": "cardiovascular.hasEstablishedCvd", "op": "eq", "value": true }
            ]
          }
        },
        "onMissingData": "stop",
        "sourceRefs": [
          {
            "sourceId": "image_01_bp_diagnosis",
            "page": 1,
            "section": "Sơ đồ chẩn đoán tăng huyết áp",
            "tableOrFigure": "codex-clipboard-18a6b413-7b8f-4c99-9c3c-6367d9872ebc.png",
            "note": "sys-bp-second 140–179 hoặc dias-bp-second 90–119 hoặc tổn thương cơ quan đích/bệnh tim mạch"
          }
        ]
      },
      {
        "id": "bp_diagnosis_hypertension_from_measurement2",
        "type": "end",
        "display": {
          "title": "Tăng huyết áp",
          "detail": "hypertension.diagnosisCategory = hypertension"
        },
        "data": {
          "outcomeCode": "hypertension",
          "sets": { "hypertension.diagnosisCategory": "hypertension" }
        },
        "sourceRefs": [
          {
            "sourceId": "image_01_bp_diagnosis",
            "page": 1,
            "section": "Sơ đồ chẩn đoán tăng huyết áp",
            "tableOrFigure": "codex-clipboard-18a6b413-7b8f-4c99-9c3c-6367d9872ebc.png",
            "note": "Nhánh yes của lần đo thứ hai"
          }
        ]
      },
      {
        "id": "bp_measurement3_normal_gate",
        "type": "condition",
        "display": {
          "title": "Lần 3: HATT <130 và HATTr <85?",
          "shortLabel": "Lần 3 — HA bình thường"
        },
        "logic": {
          "predicate": {
            "all": [
              { "field": "bp.office.measurement3.systolicMmHg", "op": "lt", "value": 130 },
              { "field": "bp.office.measurement3.diastolicMmHg", "op": "lt", "value": 85 }
            ]
          }
        },
        "onMissingData": "stop",
        "sourceRefs": [
          {
            "sourceId": "image_01_bp_diagnosis",
            "page": 1,
            "section": "Sơ đồ chẩn đoán tăng huyết áp",
            "tableOrFigure": "codex-clipboard-18a6b413-7b8f-4c99-9c3c-6367d9872ebc.png",
            "note": "Nhánh cuối: sys-bp-third <130 và dias-bp-third <85"
          }
        ]
      },
      {
        "id": "bp_diagnosis_normal",
        "type": "end",
        "display": {
          "title": "Huyết áp bình thường",
          "detail": "hypertension.diagnosisCategory = normal_bp"
        },
        "data": {
          "outcomeCode": "normal_bp",
          "sets": { "hypertension.diagnosisCategory": "normal_bp" }
        },
        "sourceRefs": [
          {
            "sourceId": "image_01_bp_diagnosis",
            "page": 1,
            "section": "Sơ đồ chẩn đoán tăng huyết áp",
            "tableOrFigure": "codex-clipboard-18a6b413-7b8f-4c99-9c3c-6367d9872ebc.png",
            "note": "Nhánh <130/<85"
          }
        ]
      },
      {
        "id": "bp_measurement3_high_normal_gate",
        "type": "condition",
        "display": {
          "title": "Lần 3: HATT 130–139 hoặc HATTr 85–89?",
          "shortLabel": "Lần 3 — HA bình thường cao"
        },
        "logic": {
          "predicate": {
            "any": [
              {
                "all": [
                  { "field": "bp.office.measurement3.systolicMmHg", "op": "gte", "value": 130 },
                  { "field": "bp.office.measurement3.systolicMmHg", "op": "lte", "value": 139 }
                ]
              },
              {
                "all": [
                  { "field": "bp.office.measurement3.diastolicMmHg", "op": "gte", "value": 85 },
                  { "field": "bp.office.measurement3.diastolicMmHg", "op": "lte", "value": 89 }
                ]
              }
            ]
          }
        },
        "onMissingData": "stop",
        "sourceRefs": [
          {
            "sourceId": "image_01_bp_diagnosis",
            "page": 1,
            "section": "Sơ đồ chẩn đoán tăng huyết áp",
            "tableOrFigure": "codex-clipboard-18a6b413-7b8f-4c99-9c3c-6367d9872ebc.png",
            "note": "Nhánh cuối: sys-bp-third 130–139 hoặc dias-bp-third 85–89"
          }
        ]
      },
      {
        "id": "bp_diagnosis_high_normal",
        "type": "end",
        "display": {
          "title": "Huyết áp bình thường cao",
          "detail": "hypertension.diagnosisCategory = high_normal_bp"
        },
        "data": {
          "outcomeCode": "high_normal_bp",
          "sets": { "hypertension.diagnosisCategory": "high_normal_bp" }
        },
        "sourceRefs": [
          {
            "sourceId": "image_01_bp_diagnosis",
            "page": 1,
            "section": "Sơ đồ chẩn đoán tăng huyết áp",
            "tableOrFigure": "codex-clipboard-18a6b413-7b8f-4c99-9c3c-6367d9872ebc.png",
            "note": "Nhánh 130–139/85–89"
          }
        ]
      },
      {
        "id": "bp_diagnosis_hypertension_from_measurement3",
        "type": "end",
        "display": {
          "title": "Tăng huyết áp",
          "detail": "hypertension.diagnosisCategory = hypertension"
        },
        "data": {
          "outcomeCode": "hypertension",
          "sets": { "hypertension.diagnosisCategory": "hypertension" }
        },
        "sourceRefs": [
          {
            "sourceId": "image_01_bp_diagnosis",
            "page": 1,
            "section": "Sơ đồ chẩn đoán tăng huyết áp",
            "tableOrFigure": "codex-clipboard-18a6b413-7b8f-4c99-9c3c-6367d9872ebc.png",
            "note": "Nhánh còn lại: ≥140/90"
          }
        ]
      },
      {
        "id": "bp_link_risk_stratification",
        "type": "link",
        "display": {
          "title": "Chuyển sang phân tầng nguy cơ tim mạch",
          "shortLabel": "Cây tiếp theo"
        },
        "data": {
          "targetTreeId": "hypertension_risk_stratification"
        },
        "sourceRefs": [
          {
            "sourceId": "image_01_bp_diagnosis",
            "page": 1,
            "section": "Sơ đồ chẩn đoán tăng huyết áp",
            "tableOrFigure": "codex-clipboard-18a6b413-7b8f-4c99-9c3c-6367d9872ebc.png",
            "note": "Nhánh THA chuyển sang Cây 3"
          }
        ]
      },
      {
        "id": "bp_link_thresholds_targets",
        "type": "link",
        "display": {
          "title": "Chuyển sang xác định mục tiêu huyết áp",
          "shortLabel": "Cây mục tiêu"
        },
        "data": {
          "targetTreeId": "bp_thresholds_targets"
        },
        "sourceRefs": [
          {
            "sourceId": "image_01_bp_diagnosis",
            "page": 1,
            "section": "Sơ đồ chẩn đoán tăng huyết áp",
            "tableOrFigure": "codex-clipboard-18a6b413-7b8f-4c99-9c3c-6367d9872ebc.png",
            "note": "Nhánh HABTC chuyển sang Cây 2"
          }
        ]
      }
    ],
    "edges": [
      { "from": "bp_diagnosis_start", "to": "bp_measurement1_crisis_gate", "when": "default" },
      { "from": "bp_measurement1_crisis_gate", "to": "bp_diagnosis_crisis", "when": "true", "label": "Có" },
      { "from": "bp_measurement1_crisis_gate", "to": "bp_measurement2_hypertension_gate", "when": "false", "label": "Không" },
      { "from": "bp_measurement2_hypertension_gate", "to": "bp_diagnosis_hypertension_from_measurement2", "when": "true", "label": "Có" },
      { "from": "bp_measurement2_hypertension_gate", "to": "bp_measurement3_normal_gate", "when": "false", "label": "Không" },
      { "from": "bp_measurement3_normal_gate", "to": "bp_diagnosis_normal", "when": "true", "label": "<130/<85" },
      { "from": "bp_measurement3_normal_gate", "to": "bp_measurement3_high_normal_gate", "when": "false", "label": "Không" },
      { "from": "bp_measurement3_high_normal_gate", "to": "bp_diagnosis_high_normal", "when": "true", "label": "130–139/85–89" },
      { "from": "bp_measurement3_high_normal_gate", "to": "bp_diagnosis_hypertension_from_measurement3", "when": "false", "label": "≥140/90" },
      { "from": "bp_diagnosis_hypertension_from_measurement2", "to": "bp_link_risk_stratification", "when": "default", "label": "THA" },
      { "from": "bp_diagnosis_hypertension_from_measurement3", "to": "bp_link_risk_stratification", "when": "default", "label": "THA" },
      { "from": "bp_diagnosis_high_normal", "to": "bp_link_thresholds_targets", "when": "default", "label": "HABTC" }
    ],
    "sourceRefs": [
