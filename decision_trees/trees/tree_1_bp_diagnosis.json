      },
      {
        "id": "bp_first_screen",
        "type": "condition",
        "display": {
          "title": "HATT ≥180 mmHg hoặc HATTr ≥120 mmHg hoặc có tổn thương cơ quan đích/bệnh tim mạch?",
          "detail": "Nếu Có: Cơn tăng huyết áp. Nếu Không: tiếp tục kiểm tra huyết áp phòng khám lần 2."
        },
        "sourceRefs": [
          {
            "sourceId": "image_01_bp_diagnosis",
            "page": 1,
            "section": "Sơ đồ chẩn đoán tăng huyết áp",
