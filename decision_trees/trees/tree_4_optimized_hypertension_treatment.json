            "note": "Nhánh out of range"
          }
        ]
      },
      {
        "id": "treatment_four_week_gate",
        "type": "condition",
        "display": {
          "title": "Phác đồ đã được sử dụng ≥4 tuần?",
          "shortLabel": "Đủ 4 tuần"
        },
        "logic": {
          "predicate": {
            "field": "medication.regimenAtLeastFourWeeks",
            "op": "eq",
            "value": true
          }
        },
        "onMissingData": "stop",
        "sourceRefs": [
          {
            "sourceId": "image_04_optimized_hypertension_treatment",
            "page": 1,
            "section": "Phân loại thuốc và tối ưu phác đồ",
            "tableOrFigure": "codex-clipboard-a6e04fc5-cc06-4938-982a-176da6ea8a69.png",
