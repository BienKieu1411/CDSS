{
  "formatVersion": "decision-tree.v1",
  "tree": {
    "id": "optimized_hypertension_treatment",
    "name": "Cây 4 — Tối ưu phác đồ điều trị tăng huyết áp",
    "purpose": "Đánh giá huyết áp gần nhất, thời gian sử dụng phác đồ và số nhóm thuốc để xác định chưa kiểm soát, bổ sung nhóm D hoặc chuyển đánh giá tăng huyết áp kháng trị.",
    "clinicalStatus": "draft",
    "entryNodeId": "treatment_start",
    "inputVariables": [
      "bp.latestSystolicMmHg",
      "bp.latestDiastolicMmHg",
      "medication.regimenAtLeastFourWeeks",
      "medication.regimenStartDate",
      "medication.antihypertensiveDrugClasses",
      "medication.antihypertensiveDrugClassCount"
    ],
    "outputVariables": [],
    "linksTo": [
      "uncontrolled_resistant_hypertension"
    ],
    "nodes": [
      {
        "id": "treatment_start",
        "type": "start",
        "display": {
          "title": "Bắt đầu đánh giá phác đồ điều trị",
          "detail": "Dùng HATT/HATTr gần nhất, thời gian dùng phác đồ và danh sách nhóm thuốc A/B/C/D."
        },
        "sourceRefs": [
          {
            "sourceId": "image_04_optimized_hypertension_treatment",
            "page": 1,
            "section": "Phân loại thuốc và tối ưu phác đồ",
            "tableOrFigure": "codex-clipboard-a6e04fc5-cc06-4938-982a-176da6ea8a69.png",
            "note": "Sơ đồ người dùng cung cấp"
          }
        ]
      },
      {
        "id": "treatment_bp_range_gate",
        "type": "condition",
        "display": {
          "title": "HATT gần nhất 140–169 và HATTr gần nhất 90–99?",
          "shortLabel": "Kiểm tra khoảng huyết áp"
        },
        "logic": {
          "predicate": {
            "all": [
              { "field": "bp.latestSystolicMmHg", "op": "gte", "value": 140 },
              { "field": "bp.latestSystolicMmHg", "op": "lte", "value": 169 },
              { "field": "bp.latestDiastolicMmHg", "op": "gte", "value": 90 },
              { "field": "bp.latestDiastolicMmHg", "op": "lte", "value": 99 }
            ]
          }
        },
        "onMissingData": "stop",
        "sourceRefs": [
          {
            "sourceId": "image_04_optimized_hypertension_treatment",
            "page": 1,
            "section": "Phân loại thuốc và tối ưu phác đồ",
            "tableOrFigure": "codex-clipboard-a6e04fc5-cc06-4938-982a-176da6ea8a69.png",
            "note": "HATT/HATTr gần nhất; ngoài khoảng → defer"
          }
        ]
      },
      {
        "id": "treatment_defer_bp_out_of_range",
        "type": "end",
        "display": {
          "title": "Defer — huyết áp ngoài khoảng xử lý",
          "shortLabel": "Defer"
        },
        "data": {
          "outcomeCode": "defer_bp_out_of_range"
        },
        "sourceRefs": [
          {
            "sourceId": "image_04_optimized_hypertension_treatment",
            "page": 1,
            "section": "Phân loại thuốc và tối ưu phác đồ",
