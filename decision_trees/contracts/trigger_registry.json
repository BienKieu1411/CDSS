{
  "formatVersion": "clinical-flow-trigger-registry.v1",
  "treeBundle": "decision_trees/bundle/decision_tree_bundle.json",
  "owner": "clinical-flow",
  "notes": [
    "Runtime hiện kích hoạt đủ Cây 1–5 theo thứ tự lâm sàng.",
    "Cây 3 chuyển trực tiếp sang Cây 5 ở nhánh 4 nhóm thuốc chưa kiểm soát.",
    "requiredVariables là dữ liệu thô tối thiểu để mở form/adapter; biến derived được engine tạo từ context và không yêu cầu người dùng nhập lại."
  ],
  "triggers": [
    {
      "id": "bp_diagnosis_started",
      "event": "encounter.hypertension_assessment_started",
      "entryTreeId": "bp_diagnosis",
      "activationMode": "direct",
      "priority": 100,
      "runPolicy": "once_per_encounter",
      "requiredVariables": [
        "bp.office1.systolicMmHg",
        "bp.office1.diastolicMmHg",
        "bp.office2.systolicMmHg",
        "bp.office2.diastolicMmHg",
        "bp.office3.systolicMmHg",
        "bp.office3.diastolicMmHg",
        "patient.diagnosisCodes"
      ],
      "inputMode": "shared_patient_context",
      "guard": {
        "field": "bp.office1.systolicMmHg",
        "op": "present"
      }
    },
    {
      "id": "hypertension_risk_stratification_started",
      "event": "decision.bp_diagnosis_completed",
      "entryTreeId": "hypertension_risk_stratification",
      "activationMode": "direct",
      "priority": 110,
      "runPolicy": "once_per_encounter",
      "requiredVariables": [
        "bp.latest.systolicMmHg",
        "bp.latest.diastolicMmHg",
        "patient.diagnosisCodes"
      ],
      "inputMode": "shared_patient_context",
      "guard": {
        "field": "bp.latest.systolicMmHg",
        "op": "present"
      }
    },
    {
      "id": "optimized_hypertension_treatment_started",
      "event": "decision.bp_thresholds_targets_completed",
      "entryTreeId": "optimized_hypertension_treatment",
      "activationMode": "direct",
      "priority": 130,
      "runPolicy": "once_per_encounter",
      "requiredVariables": [
        "patient.birthDate",
        "encounter.number",
        "bp.latest.systolicMmHg",
        "bp.latest.diastolicMmHg",
        "medication.previousEncounterDrugNames"
      ],
      "inputMode": "shared_patient_context",
      "guard": {
        "field": "encounter.number",
        "op": "present"
      }
    },
    {
      "id": "uncontrolled_resistant_hypertension_started",
      "event": "decision.optimized_hypertension_treatment_completed",
      "entryTreeId": "uncontrolled_resistant_hypertension",
      "activationMode": "link_or_direct",
      "priority": 200,
      "runPolicy": "once_per_encounter",
      "requiredVariables": [
        "bp.latest.systolicMmHg",
        "bp.latest.diastolicMmHg",
        "medication.regimenStableWeeks",
        "medication.currentDrugNames"
      ],
      "inputMode": "shared_patient_context",
      "guard": {
        "field": "bp.latest.systolicMmHg",
        "op": "present"
      }
    },
    {
      "id": "bp_thresholds_targets_started",
      "event": "decision.hypertension_risk_stratification_completed",
      "entryTreeId": "bp_thresholds_targets",
      "activationMode": "direct",
      "priority": 120,
      "runPolicy": "once_per_encounter",
      "requiredVariables": [
        "bp.category",
        "risk.class",
        "encounter.number",
        "patient.diagnosisCodes"
      ],
      "inputMode": "shared_patient_context",
      "guard": {
        "field": "bp.category",
        "op": "in",
        "value": ["high_normal", "grade1", "grade2", "hypertension", "masked_hypertension"]
      }
    }
  ]
}
