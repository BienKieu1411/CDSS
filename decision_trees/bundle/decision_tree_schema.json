{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cdss.local/schemas/decision-tree-bundle.v1.json",
  "title": "CDSS Decision Tree Bundle",
  "type": "object",
  "required": ["formatVersion", "bundleId", "bundleVersion", "locale", "sourceDocuments", "variables", "trees"],
  "properties": {
    "formatVersion": { "const": "decision-tree-bundle.v1" },
    "bundleId": { "type": "string", "minLength": 1 },
    "bundleVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "locale": { "type": "string", "minLength": 2 },
    "clinicalStatus": { "enum": ["draft", "under_review", "approved", "retired"] },
    "clinicalReviewRequired": { "type": "boolean" },
    "sourceDocuments": {
      "type": "array",
      "items": { "$ref": "#/$defs/sourceDocument" },
      "minItems": 1
    },
    "variables": {
      "type": "array",
      "items": { "$ref": "#/$defs/variable" },
      "minItems": 1,
      "uniqueItems": true
    },
    "trees": {
      "type": "array",
      "items": { "$ref": "#/$defs/tree" },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "$defs": {
    "sourceDocument": {
      "type": "object",
      "required": ["id", "title", "version"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "version": { "type": "string" },
        "uri": { "type": "string" },
        "localFile": { "type": "string" }
      },
      "additionalProperties": false
    },
    "sourceRef": {
      "type": "object",
      "required": ["sourceId"],
      "properties": {
        "sourceId": { "type": "string" },
        "page": { "type": "integer", "minimum": 1 },
        "section": { "type": "string" },
        "tableOrFigure": { "type": "string" },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "variable": {
      "type": "object",
      "required": ["id", "label", "dataType", "requiredForEvaluation"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*(\\.[a-zA-Z0-9_]+)*$" },
        "label": { "type": "string" },
        "dataType": { "enum": ["boolean", "integer", "number", "string", "enum"] },
        "unit": { "type": ["string", "null"] },
        "requiredForEvaluation": { "type": "boolean" },
        "allowedValues": { "type": "array", "items": {} },
        "definition": { "type": "string" },
        "sourceSystem": { "enum": ["patient", "encounter", "vitals", "laboratory", "medication", "problem_list", "derived", "clinician_input"] },
        "derivedFrom": { "type": "array", "items": { "type": "string" } },
        "sourceRefs": { "type": "array", "items": { "$ref": "#/$defs/sourceRef" } },
        "validation": { "type": "object", "additionalProperties": true }
      },
      "allOf": [
        {
          "if": { "properties": { "dataType": { "const": "enum" } } },
          "then": { "required": ["allowedValues"], "properties": { "allowedValues": { "minItems": 1 } } }
        }
      ],
      "additionalProperties": false
    },
    "predicate": {
      "oneOf": [
        {
          "type": "object",
          "required": ["field", "op"],
          "properties": {
            "field": { "type": "string" },
            "op": { "enum": ["eq", "neq", "gt", "gte", "lt", "lte", "in", "notIn", "present"] },
            "value": {}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["all"],
          "properties": { "all": { "type": "array", "items": { "$ref": "#/$defs/predicate" }, "minItems": 1 } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["any"],
          "properties": { "any": { "type": "array", "items": { "$ref": "#/$defs/predicate" }, "minItems": 1 } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["not"],
          "properties": { "not": { "$ref": "#/$defs/predicate" } },
          "additionalProperties": false
        }
      ]
    },
    "display": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": { "type": "string" },
        "detail": { "type": "string" },
        "shortLabel": { "type": "string" }
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": ["id", "type", "display"],
      "properties": {
        "id": { "type": "string" },
        "type": { "enum": ["start", "condition", "inference", "link", "end"] },
        "display": { "$ref": "#/$defs/display" },
        "logic": {
          "type": "object",
          "properties": { "predicate": { "$ref": "#/$defs/predicate" } },
          "additionalProperties": false
        },
        "data": { "type": "object", "additionalProperties": true },
        "sourceRefs": { "type": "array", "items": { "$ref": "#/$defs/sourceRef" } },
        "onMissingData": { "enum": ["stop", "skip"] }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "condition" } } },
          "then": { "required": ["logic"], "properties": { "logic": { "required": ["predicate"] } } }
        },
        {
          "if": { "properties": { "type": { "const": "link" } } },
          "then": { "required": ["data"], "properties": { "data": { "required": ["targetTreeId"] } } }
        },
        {
          "if": { "properties": { "type": { "const": "inference" } } },
          "then": { "required": ["data"], "properties": { "data": { "required": ["resultCode"] } } }
        },
        {
          "if": { "properties": { "type": { "const": "end" } } },
          "then": { "required": ["data"], "properties": { "data": { "required": ["outcomeCode"] } } }
        }
      ],
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": ["from", "to", "when"],
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "when": { "enum": ["true", "false", "default"] },
        "label": { "type": "string" }
      },
      "additionalProperties": false
    },
    "tree": {
      "type": "object",
      "required": ["id", "name", "purpose", "entryNodeId", "nodes", "edges", "outputVariables"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "purpose": { "type": "string" },
        "clinicalStatus": { "enum": ["draft", "under_review", "approved", "retired"] },
        "entryNodeId": { "type": "string" },
        "entryPreconditions": { "$ref": "#/$defs/predicate" },
        "inputVariables": { "type": "array", "items": { "type": "string" } },
        "outputVariables": { "type": "array", "items": { "type": "string" } },
        "linksTo": { "type": "array", "items": { "type": "string" } },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" }, "minItems": 1, "uniqueItems": true },
        "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } },
        "sourceRefs": { "type": "array", "items": { "$ref": "#/$defs/sourceRef" } },
        "notes": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  }
}
